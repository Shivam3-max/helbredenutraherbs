<nav class="wrap crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a><span>/</span>
  <a href="/pages/ingredients">Ingredients</a><span>/</span>
  <span class="t-dim">{{ ingredient.name }}</span>
</nav>

<section class="sec sec--tight" data-reveal>
  <div class="wrap wrap--narrow">
    <div class="sec-head">
      <span class="sec-head__pre">ingredient</span>
      <h1 class="sec-head__main">{{ ingredient.name }}</h1>
    </div>
    <p class="t-lede">{{ ingredient.body }}</p>
  </div>
</section>

<section class="sec sec--tint" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-head__pre">found in</span>
      <h2 class="sec-head__main">{{ ingredient.products.size }} formula{% if ingredient.products.size != 1 %}s{% endif %}</h2>
    </div>
    <div class="grid grid--4">
      {%- for p in ingredient.products -%}{% render 'product-card', product: p %}{%- endfor -%}
    </div>
  </div>
</section>
