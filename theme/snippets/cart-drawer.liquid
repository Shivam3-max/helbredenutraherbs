<aside class="drawer" data-panel="cart" aria-hidden="true" aria-label="Shopping cart">
  <div class="drawer__hd">
    <span class="t-mono">Your cart <em data-cart-count-text>({{ cart.item_count }})</em></span>
    <button class="iconbtn" data-close aria-label="Close cart">{% render 'icon', name: 'close', size: 20 %}</button>
  </div>

  <div class="ship-bar" data-ship-bar data-threshold="{{ settings.free_ship_threshold }}">
    <p class="ship-bar__txt" data-ship-text></p>
    <div class="ship-bar__track"><span class="ship-bar__fill" data-ship-fill></span></div>
  </div>

  <div class="drawer__body" data-cart-body>
    <div class="cart-empty" data-cart-empty>
      <p class="cart-empty__t">Your cart is empty</p>
      <p class="t-dim t-sm">Start with a concern and we will narrow it down.</p>
      <a class="btn btn--ghost btn--sm" href="/collections/all" data-close>Browse all formulas</a>
    </div>
    <ul class="cart-lines" data-cart-lines></ul>
  </div>

  <div class="drawer__foot" data-cart-foot hidden>
    <div class="cart-tot">
      <span>Subtotal</span>
      <strong data-cart-total>{{ cart.total_price | money }}</strong>
    </div>
    <p class="t-sm t-dim-3">Taxes included. Shipping calculated at checkout.</p>
    <a class="btn btn--primary btn--block btn--lg" href="/checkout">Checkout</a>
  </div>
</aside>
