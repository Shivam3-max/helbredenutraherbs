{%- comment -%}
  Kapiva's card anatomy, minus the two elements Helbrede has no source for:
  star ratings (no reviews app) and loyalty coins (no loyalty app). Both slots
  exist and light up the moment their data does.
{%- endcomment -%}
{%- assign v = product.variants | first -%}
{%- assign product_category = product.type | default: product.vendor -%}
{%- comment -%} Shopify product.title is the full merchandising string (~100 chars); the card is built around the short name. {%- endcomment -%}
{%- assign product_name = product.metafields.helbrede.title.value | default: product.title -%}
{%- assign product_subtitle = product.metafields.descriptors.subtitle.value | default: product.metafields.custom.subtitle.value | default: product.metafields.helbrede.subtitle.value -%}
{%- assign pack_size = product.metafields.custom.pack_size.value | default: product.metafields.helbrede.pack_size.value -%}
{%- assign product_image_url = product.featured_image | image_url: width: 720 -%}
{%- comment -%}
  A third of the catalogue is out of stock at any time, and the card said
  nothing about it: same price, same Buy now, indistinguishable from something
  you can actually buy. The shopper only found out on the product page.
{%- endcomment -%}
{%- assign card_available = product.available -%}
<article class="card{% unless card_available %} card--out{% endunless %}" data-reveal-child>
  <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {% render 'media-slot',
       code: 'PDP-IMG', label: product.title, w: 1, h: 1,
       src: product_image_url, alt: product.title %}
    <div class="card__flags">
      {%- if card_available == false -%}
        <span class="badge badge--out">Sold out</span>
      {%- elsif v.compare_at_price and v.compare_at_price > v.price -%}
        {%- assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | round -%}
        <span class="badge badge--save">{{ pct }}% off</span>
      {%- else -%}<span></span>{%- endif -%}
      {%- if settings.show_ratings and product.metafields.reviews.rating.value -%}
        <span class="badge badge--gold">{{ product.metafields.reviews.rating.value }} ★</span>
      {%- endif -%}
    </div>
  </a>

  <div class="card__body">
    <div class="card__concern">{{ product_category }}</div>
    <h3 class="card__title"><a href="{{ product.url }}">{{ product_name }}</a></h3>
    {%- if product_subtitle != blank %}<p class="card__sub">{{ product_subtitle }}</p>{% endif -%}
    {%- if pack_size != blank %}<div class="card__pack">{{ pack_size }}</div>{% endif -%}

    <div class="card__foot">
      {% render 'price', amount: v.price, compare: v.compare_at_price %}
      {%- if card_available -%}
        <a class="btn btn--primary btn--sm card__cta" href="{{ product.url }}">Buy now</a>
      {%- else -%}
        <a class="btn btn--ghost btn--sm card__cta card__cta--out" href="{{ product.url }}">Sold out</a>
      {%- endif -%}
    </div>
  </div>
</article>
