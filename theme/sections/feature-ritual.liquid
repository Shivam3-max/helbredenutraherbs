{%- comment -%}
  Homepage teaser for the Ritual Builder — the second signature feature.
  Shows one worked example: a topical, a daily base and a night formula, drawn
  from three different concerns, which is the shelf an ingestibles-only brand
  cannot assemble.
{%- endcomment -%}
{%- assign morning = section.settings.morning_product -%}
{%- assign daily   = section.settings.daily_product -%}
{%- assign night   = section.settings.night_product -%}
{%- if morning.variants == blank -%}{%- assign matches = collections.all.products | where: 'handle', section.settings.morning_product -%}{%- assign morning = matches.first -%}{%- endif -%}
{%- if daily.variants == blank -%}{%- assign matches = collections.all.products | where: 'handle', section.settings.daily_product -%}{%- assign daily = matches.first -%}{%- endif -%}
{%- if night.variants == blank -%}{%- assign matches = collections.all.products | where: 'handle', section.settings.night_product -%}{%- assign night = matches.first -%}{%- endif -%}
{%- if morning == blank -%}{%- assign matches = all_products | where: 'handle', section.settings.morning_product -%}{%- assign morning = matches.first -%}{%- endif -%}
{%- if daily == blank -%}{%- assign matches = all_products | where: 'handle', section.settings.daily_product -%}{%- assign daily = matches.first -%}{%- endif -%}
{%- if night == blank -%}{%- assign matches = all_products | where: 'handle', section.settings.night_product -%}{%- assign night = matches.first -%}{%- endif -%}

<section class="sec" data-reveal>
  <div class="wrap split split--flip">

    <div class="split__art">
      <div class="ritual">
        {%- assign slots = 'Morning,Daily,Night' | split: ',' -%}
        {%- for slot in slots -%}
          {%- case slot -%}
            {%- when 'Morning' -%}{%- assign pr = morning -%}
            {%- when 'Daily'   -%}{%- assign pr = daily -%}
            {%- else           -%}{%- assign pr = night -%}
          {%- endcase -%}
          {%- if pr -%}
            {%- assign v = pr.variants | first -%}
            <a class="rit" href="{{ pr.url }}">
              <span class="rit__slot">{{ slot }}</span>
              <img class="rit__img" src="{{ pr.featured_image | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">
              <span>
                <span class="rit__t">{{ pr.metafields.helbrede.title.value | default: pr.title }}</span>
                <span class="rit__n">{{ pr.type | default: pr.vendor }}</span>
              </span>
              <span class="rit__p">{{ v.price | money }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div>
      <div class="sec-head">
        <span class="sec-head__pre">one capsule is rarely the</span>
        <h2 class="sec-head__main">Whole answer</h2>
      </div>
      <p class="t-lede">
        Helbrede makes both halves of a routine — the tablet you take and the serum
        or oil you apply. So instead of selling you one bottle, we can lay out the
        full day: something in the morning, the daily base underneath it, and the
        recovery step at night.
      </p>
      <ul class="ticks" style="margin-top:1.25rem">
        <li>Built across concerns, not just within one</li>
        <li>Swap or remove anything you already own</li>
        <li>Add the whole routine to your cart in one action</li>
      </ul>
      <a class="btn btn--primary" href="/pages/ritual-builder" style="margin-top:1.5rem">Build your ritual</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Feature — ritual",
  "settings": [
    { "type": "product", "id": "morning_product", "label": "Morning product" },
    { "type": "product", "id": "daily_product", "label": "Daily product" },
    { "type": "product", "id": "night_product", "label": "Night product" }
  ],
  "presets": [{ "name": "Feature — ritual" }]
}
{% endschema %}
