{%- comment -%} Homepage teaser for the Label Panel — the signature feature. {%- endcomment -%}
{%- assign p = section.settings.product -%}
{%- if p.variants == blank -%}{%- assign selected_products = collections.all.products | where: 'handle', section.settings.product -%}{%- assign p = selected_products.first -%}{%- endif -%}
{%- if p == blank -%}{%- assign selected_products = all_products | where: 'handle', section.settings.product -%}{%- assign p = selected_products.first -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = collections.all.products.first -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = all_products.first -%}{%- endif -%}
{%- assign product_name = p.metafields.helbrede.title.value | default: p.title -%}
<section class="sec sec--tint" data-reveal>
  <div class="wrap split">
    <div>
      <div class="sec-head">
        <span class="sec-head__pre">the difference is</span>
        <h2 class="sec-head__main">A number, not an adjective</h2>
      </div>
      <p class="t-lede">
        Product information should be clear before you buy. Review the formula,
        category, availability and current price directly from the store catalogue,
        with full product details available on every product page.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/pages/label-check">Compare two formulas</a>
        <a class="btn btn--ghost" href="/pages/ingredients">Ingredient library</a>
      </div>
    </div>

    <div class="label-panel">
      <div class="label-panel__hd">
        <span class="label-panel__t">Product details</span>
        <span class="label-panel__s">{{ p.vendor }}</span>
      </div>
      <div class="label-panel__rule"></div>
      <div class="label-row"><span class="label-row__n">Product</span><span class="label-row__d">{{ product_name }}</span></div>
      <div class="label-row"><span class="label-row__n">Price</span><span class="label-row__d">{{ p.price | money }}</span></div>
      <div class="label-row"><span class="label-row__n">Category</span><span class="label-row__d">{{ p.type | default: p.vendor }}</span></div>
      <div class="label-row"><span class="label-row__n">Availability</span><span class="label-row__d">{% if p.available %}In stock{% else %}Sold out{% endif %}</span></div>
      <p class="label-panel__ft">Live catalogue information for {{ product_name }}.</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Feature — label",
  "settings": [
    { "type": "product", "id": "product", "label": "Featured product" }
  ],
  "presets": [{ "name": "Feature — label" }]
}
{% endschema %}
