{%- assign c = collection -%}
<nav class="wrap crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a><span>/</span>
  <span class="t-dim">{{ c.title }}</span>
</nav>

<section class="sec sec--tight" data-reveal>
  <div class="wrap">
    <header class="coll__head">
      <div class="sec-head">
        <span class="sec-head__pre">browse</span>
        <h1 class="sec-head__main">{{ c.title }}</h1>
      </div>
      {%- if c.description != blank -%}<p class="t-lede coll__desc">{{ c.description }}</p>{%- endif -%}
    </header>

    <div class="coll__bar" data-collection>
      {%- assign filter_values = c.all_tags -%}
      {%- if filter_values == blank -%}{%- assign filter_values = c.filters -%}{%- endif -%}
      {%- if filter_values.size > 0 -%}
        <div class="coll__filters" role="group" aria-label="Refine">
          <button class="chip is-on" type="button" data-filter="*" aria-pressed="true">
            <span class="chip__dot" aria-hidden="true"></span>All {{ c.products_count }}
          </button>
          {%- for tag in filter_values limit: 10 -%}
            <button class="chip" type="button" data-filter="{{ tag | escape }}" aria-pressed="false">
              <span class="chip__dot" aria-hidden="true"></span>{{ tag }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <label class="coll__sort">
        <span class="t-mono">Sort</span>
        <select data-sort>
          <option value="featured">Featured</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>
    </div>

    <p class="coll__count" data-count hidden></p>

    {%- comment -%}
      In-stock products lead. Some concerns are half out of stock — hair care
      and daily essentials are both three of six or five — so leaving Shopify's
      order alone puts unbuyable products at the top of the grid. Two passes
      over the same page rather than a sort, because Liquid cannot sort on
      `available`.
    {%- endcomment -%}
    {%- paginate c.products by 24 -%}
    <div class="grid grid--4" data-grid>
      {%- for pass in (1..2) -%}
        {%- for p in c.products -%}
          {%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}
          {%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}
          {%- assign product_filters = p.tags -%}
          {%- if product_filters == blank -%}{%- assign product_filters = p.filters -%}{%- endif -%}
          <div data-item data-filters="{{ product_filters | join: '|' | escape }}" data-price="{{ p.price }}" data-name="{{ p.metafields.helbrede.title.value | default: p.title | escape }}" data-available="{{ p.available }}">
            {% render 'product-card', product: p %}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="coll__pagination" aria-label="Collection pages">
        {%- if paginate.previous -%}<a class="btn btn--ghost btn--sm" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        <span class="t-mono">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="btn btn--ghost btn--sm" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
    {%- endpaginate -%}

    <p class="coll__none" data-none hidden>Nothing matches that combination. Clear a filter to see more.</p>
  </div>
</section>
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
